<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs CoordinateParser (TomTom's parser), CoordinateFormat, SafeFile (the crash-safe route save), Hotkeys
    (reading a key Valheim cannot read), the location search's Unity-free parts (RoutePlanner, SearchCatalog,
    SearchRules) and the messages a server running the plugin exchanges with players (FindProtocol) outside
    Unity. Shims.cs supplies the handful of UnityEngine
    types, the BepInEx config entry and the ZInput reads they touch, so the real source is
    compiled and exercised unmodified rather than being copied or reimplemented. Built without the
    WAYFINDER symbol, i.e. as TomTom - the only edition that has a parser to test.

    Run it with run-tests.sh, or from the tests folder with "dotnet run".
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Waypointer.Tests</AssemblyName>
    <RootNamespace>Waypointer</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>..\build\tests\</BaseOutputPath>
    <OutputPath>..\build\tests\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Shims.cs" />
    <Compile Include="TestMain.cs" />
    <Compile Include="..\src\CoordinateParser.cs" />
    <Compile Include="..\src\CoordinateFormat.cs" />
    <Compile Include="..\src\SafeFile.cs" />
    <Compile Include="..\src\Hotkeys.cs" />
    <Compile Include="..\src\RoutePlanner.cs" />
    <Compile Include="..\src\SearchCatalog.cs" />
    <Compile Include="..\src\SearchRules.cs" />
    <Compile Include="..\src\FindProtocol.cs" />
  </ItemGroup>

</Project>
